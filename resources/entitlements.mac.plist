<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The hardened runtime is required for notarization, and it blocks by
         default the two things a Chromium renderer cannot do without: compiling
         JavaScript at run time, and executing the pages it just wrote. Without
         these the app is signed and notarized and then crashes on launch. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Electron ships helper binaries and frameworks that are signed
         separately from the main executable; library validation would refuse to
         load them into the same process. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
